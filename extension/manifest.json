{
  "manifest_version": 3,
  "name": "FoxPro → Gemini",
  "description": "Extrai o código de formulários Visual FoxPro (.scx) via Class Browser e anexa como arquivo .txt no Gemini. Ativa apenas em uma aba do Gemini com conta logada.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://gemini.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini-auth.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FoxPro → Gemini",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
